# ---- secrets (never commit a real key) ----
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ---- deployed contract (filled in by scripts/deploy.js) ----
MICROLEND_CONTRACT_ADDRESS=0xECDaCA02f7646A8182A57c6520318D0FebC8bDCA
MICROLEND_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=11155111

# ---- backend ----
FLASK_SECRET_KEY=change-me-in-production
DATABASE_PATH=backend/data/microlend.db
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# "mock" (offline demo) or "rpc" (verify receipts against the chain)
CHAIN_MODE=rpc
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
AUTH_TOKEN_TTL_SECONDS=7200
