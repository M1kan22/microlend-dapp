# ---------------------------------------------------------------------------
# MicroLend DApp — repository ignore rules
# ---------------------------------------------------------------------------

# Local developer toolchain (bundled runtimes, offline wheel cache) — dev only
.tooling/
.tooling-npmcache/
.piptmp/
piptmp/
.pipcache/
wheels/
probe.py
pip*.txt

# Secrets
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
package-lock.json

# Databases and generated runtime data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/logs/

# Generated build output
artifacts/*.json
deployment.local.json
dist/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Screenshot working files (only docs/images/*.png are committed)
*.tmp.png
